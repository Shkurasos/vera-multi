{
  "name": "vera-multi-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "VERA Multi — десктоп-приложение (Electron shell). Подключается к единому серверу (Web-клиент).",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "app.vera.multi",
    "productName": "VERA Multi",
    "files": [
      "electron/**/*"
    ],
    "directories": {
      "output": "dist-electron-build"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}