# Server/.env.example — скопируй в Server/.env и заполни своими значениями.
# Реальный .env в git не попадает (см. корневой .gitignore).

# JWT-подпись access-токенов. Минимум 32 символа. Локально можно сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Администраторы по username (CSV, регистр не важен).
ADMIN_USERNAMES=Vera_koto_a,Vera_koto_b

# YooMoney: wallet number and HTTP notification secret (server only).
YOOMONEY_RECEIVER=
YOOMONEY_NOTIFICATION_SECRET=
# Explicit opt-in for legacy mock payments; forbidden in production.
WALLET_ALLOW_MOCK=false

# NOWPayments — крипто-приём. Получить в личном кабинете:
#   Store settings → API keys → Create API key
NOWPAYMENTS_API_KEY=
# Store settings → IPN Settings → Regenerate IPN Secret
NOWPAYMENTS_IPN_SECRET=

# Опционально: публичный URL (нужен self-ping и success_url инвойсов).
# Для Render:
# PUBLIC_URL=https://vera-koto.onrender.com
# Для домашнего режима через Cloudflare Tunnel (см. local/README-HOME.md):
# NODE_ENV=production
# PUBLIC_URL=https://chat.твой-домен.ru

# Опционально: CSV whitelist Origin для CORS.
# CORS_ORIGIN=http://localhost:5173

# DEV-режим по IP. CSV из публичных IP разработчика. Пользователь, зашедший
# с любого из них, автоматически получает isDev:true — весь магазин открыт,
# покупки бесплатны, включён inspector-оверлей на клиенте (Ctrl+ПКМ).
# DEV_IPS=91.235.175.156
